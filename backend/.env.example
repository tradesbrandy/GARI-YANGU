# Copy to .env and edit. All values are optional for local development.
SECRET_KEY=change-me-in-production
# Default is a local SQLite file. For PostgreSQL use e.g.
# DATABASE_URL=postgresql+psycopg2://user:pass@localhost:5432/gariyangu
DATABASE_URL=sqlite:///gariyangu.db
CORS_ORIGINS=http://localhost:5173
TOKEN_HOURS=72

# Persistent directory for uploaded vehicle photos
UPLOAD_FOLDER=uploads
